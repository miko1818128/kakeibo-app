function importMonthlySheets(){const ss=SpreadsheetApp.openById(SHEET_ID),sync=sheet_(),existing=sync.getDataRange().getValues(),ids=new Set();for(let i=1;i<existing.length;i++)if(existing[i][0]==='RECORD')try{const r=JSON.parse(existing[i][1]);if(r&&r.id)ids.add(r.id)}catch(_){}
let added=0,skipped=0;['8月','9月'].forEach(name=>{const sh=ss.getSheetByName(name);if(!sh)return;const vals=sh.getDataRange().getValues();if(vals.length<2)return;const hdr=vals[1].map(text_),ix=s=>hdr.indexOf(s);const day=ix('日'),purpose=ix('用途'),payment=ix('支払い方法'),who=ix('誰用?'),amount=ix('金額'),discount=ix('値引き（ポイント等）'),cls=ix('分類'),detail=ix('詳細'),month=Number(name.replace('月',''));if(day<0||amount<0)return;for(let i=2;i<vals.length;i++){const row=vals[i],d=Number(row[day]),a=money_(row[amount]);if(!Number.isFinite(d)||d<1||d>31||!Number.isFinite(a)||a===0){skipped++;continue}const date='2026-'+String(month).padStart(2,'0')+'-'+String(d).padStart(2,'0'),id='sheet-'+month+'-'+(i+1),rec={id,date,purpose:text_(row[purpose]),payment:text_(row[payment]),who:who>=0?text_(row[who]):'',amount:a,discount:discount>=0?(money_(row[discount])||0):0,classification:cls>=0?text_(row[cls]):'',detail:detail>=0?text_(row[detail]):'',updatedAt:1};if(ids.has(id))continue;sync.appendRow(['RECORD',JSON.stringify(rec),1]);ids.add(id);added++}});return {ok:true,added,skipped,total:ids.size}}

function repairMonthlySheets(){const ss=SpreadsheetApp.openById(SHEET_ID),v=sheet_().getDataRange().getValues();let repaired=0,checked=0;for(let i=1;i<v.length;i++){if(v[i][0]!=='RECORD')continue;let r;try{r=JSON.parse(v[i][1])}catch(_){continue}if(!r||r.deleted||!r.date||!r.id)continue;checked++;const m=Number(String(r.date).slice(5,7)),d=Number(String(r.date).slice(8,10)),sh=ss.getSheetByName(m+'月');if(!sh)continue;const last=Math.max(sh.getLastRow(),3),vals=sh.getRange(3,3,last-2,8).getDisplayValues();let full=false,partial=0;for(let j=0;j<vals.length;j++){const x=vals[j];if(Number(String(x[0]).replace(/\D/g,''))!==d||text_(x[1])!==text_(r.purpose))continue;const amount=money_(x[4]);if(text_(x[2])===text_(r.payment)&&text_(x[3])===text_(r.who)&&amount===Number(r.amount)&&money_(x[5])===Number(r.discount||0)&&text_(x[6])===text_(r.classification)&&text_(x[7])===text_(r.detail)){full=true;break}if(!partial&&text_(x[2])===''&&text_(x[3])===''&&text_(x[4])===''&&text_(x[6])===''&&text_(x[7])==='')partial=j+3}if(full)continue;if(partial){sh.getRange(partial,3,1,8).setValues([[d,r.purpose||'',r.payment||'',r.who||'',Number(r.amount)||0,Number(r.discount)||0,r.classification||'',r.detail||'']]);repaired++}}SpreadsheetApp.flush();return {ok:true,repaired,checked}}
function previewReconcileMonth_(month,records){const ss=SpreadsheetApp.openById(SHEET_ID),sh=ss.getSheetByName(month+'月');if(!sh)return {ok:false,error:'sheet not found'};const active=(records||[]).filter(r=>!r.deleted&&Number(String(r.date||'').slice(5,7))===month),last=Math.max(sh.getLastRow(),3),vals=sh.getRange(3,3,last-2,8).getValues(),used=new Set(),extra=[];function match(x,r){return Number(x[0])===Number(String(r.date).slice(8,10))&&text_(x[1])===text_(r.purpose)&&money_(x[4])===Number(r.amount)&&text_(x[7])===text_(r.detail)}for(const r of active){for(let i=0;i<vals.length;i++)if(!used.has(i)&&match(vals[i],r)){used.add(i);break}}for(let i=0;i<vals.length;i++){const x=vals[i],has=text_(x[0])!==''||text_(x[1])!==''||text_(x[2])!==''||text_(x[3])!==''||text_(x[4])!==''||text_(x[7])!=='';if(has&&!used.has(i))extra.push({row:i+3,day:x[0],purpose:text_(x[1]),payment:text_(x[2]),who:text_(x[3]),amount:money_(x[4]),discount:money_(x[5]),classification:text_(x[6]),detail:text_(x[7])})}return {ok:true,month,appRecords:active.length,extra}}
function reconcileMonth_(month,records){const ss=SpreadsheetApp.openById(SHEET_ID),sh=ss.getSheetByName(month+'月');if(!sh)return {ok:false,error:'sheet not found'};const active=(records||[]).filter(r=>!r.deleted&&Number(String(r.date||'').slice(5,7))===month),last=Math.max(sh.getLastRow(),3),vals=sh.getRange(3,3,last-2,8).getValues(),used=new Set(),extra=[];function match(x,r){return Number(x[0])===Number(String(r.date).slice(8,10))&&text_(x[1])===text_(r.purpose)&&money_(x[4])===Number(r.amount)&&text_(x[7])===text_(r.detail)}for(const r of active){let found=-1;for(let i=0;i<vals.length;i++)if(!used.has(i)&&match(vals[i],r)){found=i;break}if(found>=0)used.add(found)}for(let i=0;i<vals.length;i++){const x=vals[i],has=text_(x[0])!==''||text_(x[1])!==''||text_(x[2])!==''||text_(x[3])!==''||text_(x[4])!==''||text_(x[7])!=='';if(has&&!used.has(i))extra.push(i+3)}for(let i=extra.length-1;i>=0;i--)sh.getRange(extra[i],3,1,8).clearContent();for(const r of active){let exists=false;const now=sh.getRange(3,3,Math.max(sh.getLastRow()-2,1),8).getValues();for(const x of now)if(match(x,r)){exists=true;break}if(!exists)writeMonthly_(r)}SpreadsheetApp.flush();return {ok:true,month,records:active.length,removed:extra.length}}
function deleteRecord_(id){if(!id)return {ok:false,error:'missing id'};const sh=sheet_(),v=sh.getDataRange().getValues();for(let i=1;i<v.length;i++){if(v[i][0]!=='RECORD')continue;try{const r=JSON.parse(v[i][1]);if(r&&String(r.id)===String(id)){if(!r.deleted)clearMonthlyRecord_(r);r.deleted=true;r.updatedAt=Date.now();sh.getRange(i+1,2,1,2).setValues([[JSON.stringify(r),r.updatedAt]]);return {ok:true,id:r.id}}}catch(_){}}return {ok:false,error:'not found'}}
