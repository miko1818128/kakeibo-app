function writeMonthly_(r){const m=Number(String(r.date||'').slice(5,7)),d=Number(String(r.date||'').slice(8,10));if(!m||!d)return;const ss=SpreadsheetApp.openById(SHEET_ID),sh=ss.getSheetByName(m+'月');if(!sh)return;let row=3;while(row<=sh.getMaxRows()&&sh.getRange(row,3).getValue()!=='')row++;if(row>sh.getMaxRows())sh.insertRowAfter(sh.getMaxRows());if(row>3)sh.getRange(row-1,3,1,8).copyTo(sh.getRange(row,3,1,8),SpreadsheetApp.CopyPasteType.PASTE_FORMAT,false);sh.getRange(row,3,1,8).setValues([[d,r.purpose||'',r.payment||'',r.who||'',Number(r.amount)||0,Number(r.discount)||0,r.classification||'',r.detail||'']]);SpreadsheetApp.flush();}
function healMonthly_(r){if(!r||r.deleted||!r.date)return false;const m=Number(String(r.date).slice(5,7)),d=Number(String(r.date).slice(8,10)),sh=SpreadsheetApp.openById(SHEET_ID).getSheetByName(m+'月');if(!sh)return false;const last=Math.max(sh.getLastRow(),3),vals=sh.getRange(3,3,last-2,8).getDisplayValues();for(let i=0;i<vals.length;i++){const x=vals[i];if(Number(String(x[0]).replace(/\D/g,''))!==d||text_(x[1])!==text_(r.purpose))continue;if(text_(x[2])===''&&text_(x[3])===''&&text_(x[4])===''&&text_(x[6])===''&&text_(x[7])===''){const range=sh.getRange(i+3,3,1,8),rules=range.getDataValidations()[0];for(let k=0;k<rules.length;k++)if(rules[k])rules[k]=rules[k].copy().setAllowInvalid(true).build();range.setDataValidations([rules]);range.setValues([[d,r.purpose||'',r.payment||'',r.who||'',Number(r.amount)||0,Number(r.discount)||0,r.classification||'',r.detail||'']]);SpreadsheetApp.flush();return true}}return false}
function writeData(p){p=p||{};const sh=sheet_(),old=sh.getDataRange().getValues(),map=new Map();for(let i=1;i<old.length;i++)if(old[i][0]==='RECORD')try{const r=JSON.parse(old[i][1]);if(r&&r.id)map.set(r.id,{r,row:i+1})}catch(_){}for(const r of(p.records||[])){if(!r.id||!r.date||!Number.isFinite(Number(r.amount)))continue;if(!r.deleted)healMonthly_(r);const o=map.get(r.id);if(!o){sh.appendRow(['RECORD',JSON.stringify(r),r.updatedAt||Date.now()]);if(!r.deleted)writeMonthly_(r)}else if((r.updatedAt||0)>(o.r.updatedAt||0)){clearMonthlyRecord_(o.r);if(!r.deleted)writeMonthly_(r);sh.getRange(o.row,2,1,2).setValues([[JSON.stringify(r),r.updatedAt||Date.now()]])}}const c=p.config||{},data=sh.getDataRange().getValues();let row=-1;for(let i=1;i<data.length;i++)if(data[i][0]==='CONFIG'){row=i+1;break}if(row<0)sh.appendRow(['CONFIG',JSON.stringify(c),c.updatedAt||Date.now()]);else{let oc={};try{oc=JSON.parse(data[row-1][1])}catch(_){}if((c.updatedAt||0)>(oc.updatedAt||0))sh.getRange(row,2,1,2).setValues([[JSON.stringify(c),c.updatedAt||Date.now()]])}return {ok:true}}
