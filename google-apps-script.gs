const SHEET_ID='1-wwYal1BPl8CyhLwONfhAS-AKiW7u5RuEUl2ImbyhJg';
const SHEET_NAME='アプリ同期';
function sheet_(){const ss=SpreadsheetApp.openById(SHEET_ID);return ss.getSheetByName(SHEET_NAME)||ss.insertSheet(SHEET_NAME)}
function read_(){const sh=sheet_(),v=sh.getDataRange().getValues();let records=[],config=null;for(let i=1;i<v.length;i++){if(v[i][0]==='RECORD')try{const r=JSON.parse(v[i][1]);if(r&&r.date&&Number.isFinite(Number(r.amount)))records.push(r)}catch(_){}if(v[i][0]==='CONFIG')try{config=JSON.parse(v[i][1])}catch(_){}}return {ok:true,records,config}}
function doGet(e){const p=e&&e.parameter||{},d=read_(),out=JSON.stringify(d),cb=p.callback||'',token=p.token||'';if(p.mode==='iframe'){const safe=out.replace(/\\/g,'\\\\').replace(/</g,'\\u003c').replace(/>/g,'\\u003e').replace(/&/g,'\\u0026').replace(/'/g,"\\'");const t=token.replace(/[^a-zA-Z0-9_.-]/g,'');const html='<script>window.top.postMessage({type:"kakeibo-sync",token:"'+t+'",payload:'+safe+'},"*");</script><p>同期処理中…</p>';return HtmlService.createHtmlOutput(html).setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL)}return ContentService.createTextOutput(cb?cb+'('+out+')':out).setMimeType(cb?ContentService.MimeType.JAVASCRIPT:ContentService.MimeType.JSON)}
function doPost(e){const p=JSON.parse(e.postData.contents),sh=sheet_(),old=sh.getDataRange().getValues(),map=new Map();for(let i=1;i<old.length;i++)if(old[i][0]==='RECORD')try{const r=JSON.parse(old[i][1]);if(r&&r.id)map.set(r.id,{r,row:i+1})}catch(_){}for(const r of(p.records||[])){if(!r.id||!r.date||!Number.isFinite(Number(r.amount)))continue;const o=map.get(r.id);if(!o)sh.appendRow(['RECORD',JSON.stringify(r),r.updatedAt||Date.now()]);else if((r.updatedAt||0)>(o.r.updatedAt||0))sh.getRange(o.row,2,1,2).setValues([[JSON.stringify(r),r.updatedAt||Date.now()]])}const c=p.config||{},data=sh.getDataRange().getValues();let row=-1;for(let i=1;i<data.length;i++)if(data[i][0]==='CONFIG'){row=i+1;break}if(row<0)sh.appendRow(['CONFIG',JSON.stringify(c),c.updatedAt||Date.now()]);else{let oc={};try{oc=JSON.parse(data[row-1][1])}catch(_){}if((c.updatedAt||0)>(oc.updatedAt||0))sh.getRange(row,2,1,2).setValues([[JSON.stringify(c),c.updatedAt||Date.now()]])}return ContentService.createTextOutput(JSON.stringify({ok:true})).setMimeType(ContentService.MimeType.JSON)}
function setup(){const sh=sheet_();if(sh.getLastRow()===0)sh.appendRow(['TYPE','JSON','UPDATED_AT'])}