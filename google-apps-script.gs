const SHEET_ID='1-wwYal1BPl8CyhLwONfhAS-AKiW7u5RuEUl2ImbyhJg';
const SHEET_NAME='アプリ同期';
const APP_URL='https://miko1818128.github.io/kakeibo-app/';
function sheet_(){const ss=SpreadsheetApp.openById(SHEET_ID);return ss.getSheetByName(SHEET_NAME)||ss.insertSheet(SHEET_NAME)}
function readData(){const sh=sheet_(),v=sh.getDataRange().getValues();let records=[],config=null;for(let i=1;i<v.length;i++){if(v[i][0]==='RECORD')try{const r=JSON.parse(v[i][1]);if(r&&r.date&&Number.isFinite(Number(r.amount)))records.push(r)}catch(_){}if(v[i][0]==='CONFIG')try{config=JSON.parse(v[i][1])}catch(_){}}return {ok:true,records,config}}
function writeData(p){p=p||{};const sh=sheet_(),old=sh.getDataRange().getValues(),map=new Map();for(let i=1;i<old.length;i++)if(old[i][0]==='RECORD')try{const r=JSON.parse(old[i][1]);if(r&&r.id)map.set(r.id,{r,row:i+1})}catch(_){}for(const r of(p.records||[])){if(!r.id||!r.date||!Number.isFinite(Number(r.amount)))continue;const o=map.get(r.id);if(!o)sh.appendRow(['RECORD',JSON.stringify(r),r.updatedAt||Date.now()]);else if((r.updatedAt||0)>(o.r.updatedAt||0))sh.getRange(o.row,2,1,2).setValues([[JSON.stringify(r),r.updatedAt||Date.now()]])}const c=p.config||{},data=sh.getDataRange().getValues();let row=-1;for(let i=1;i<data.length;i++)if(data[i][0]==='CONFIG'){row=i+1;break}if(row<0)sh.appendRow(['CONFIG',JSON.stringify(c),c.updatedAt||Date.now()]);else{let oc={};try{oc=JSON.parse(data[row-1][1])}catch(_){}if((c.updatedAt||0)>(oc.updatedAt||0))sh.getRange(row,2,1,2).setValues([[JSON.stringify(c),c.updatedAt||Date.now()]])}return {ok:true}}
function doGet(){const html=`<!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1"><style>html,body,iframe{margin:0;width:100%;height:100%;border:0;overflow:hidden}</style></head><body><iframe id="app" src="${APP_URL}?shared=1"></iframe><script>const f=document.getElementById('app');window.addEventListener('message',e=>{const d=e.data;if(!d||!d.type||!d.type.startsWith('kakeibo-bridge-'))return;const reply=(ok,payload,error)=>f.contentWindow.postMessage({type:'kakeibo-bridge-result',token:d.token,ok,payload,error},'*');if(d.type==='kakeibo-bridge-read')google.script.run.withSuccessHandler(x=>reply(true,x)).withFailureHandler(x=>reply(false,null,String(x))).readData();if(d.type==='kakeibo-bridge-write')google.script.run.withSuccessHandler(x=>reply(true,x)).withFailureHandler(x=>reply(false,null,String(x))).writeData(d.payload)})</script></body></html>`;return HtmlService.createHtmlOutput(html).setTitle('♡ 家計簿 ♡').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL)}
function setup(){const sh=sheet_();if(sh.getLastRow()===0)sh.appendRow(['TYPE','JSON','UPDATED_AT'])}