const SHEET_ID='1-wwYal1BPl8CyhLwONfhAS-AKiW7u5RuEUl2ImbyhJg';
const SHEET_NAME='アプリ同期';
const APP_URL='https://miko1818128.github.io/kakeibo-app/?v=20260920-mobile3';
function sheet_(){const ss=SpreadsheetApp.openById(SHEET_ID);return ss.getSheetByName(SHEET_NAME)||ss.insertSheet(SHEET_NAME)}
function readData(){const sh=sheet_(),v=sh.getDataRange().getValues();let records=[],config=null;for(let i=1;i<v.length;i++){if(v[i][0]==='RECORD')try{const r=JSON.parse(v[i][1]);if(r&&r.date&&Number.isFinite(Number(r.amount)))records.push(r)}catch(_){}if(v[i][0]==='CONFIG')try{config=JSON.parse(v[i][1])}catch(_){}}return {ok:true,records,config}}
function writeMonthly_(r){const m=Number(String(r.date||'').slice(5,7)),d=Number(String(r.date||'').slice(8,10));if(!m||!d)return;const ss=SpreadsheetApp.openById(SHEET_ID),sh=ss.getSheetByName(m+'月');if(!sh)return;let row=3;while(row<=sh.getMaxRows()&&sh.getRange(row,3).getValue()!=='')row++;if(row>sh.getMaxRows())sh.insertRowAfter(sh.getMaxRows());if(row>3)sh.getRange(row-1,3,1,8).copyTo(sh.getRange(row,3,1,8),SpreadsheetApp.CopyPasteType.PASTE_FORMAT,false);sh.getRange(row,3,1,8).setValues([[d,r.purpose||'',r.payment||'',r.who||'',Number(r.amount)||0,Number(r.discount)||0,r.classification||'',r.detail||'']]);}
function writeData(p){p=p||{};const sh=sheet_(),old=sh.getDataRange().getValues(),map=new Map();for(let i=1;i<old.length;i++)if(old[i][0]==='RECORD')try{const r=JSON.parse(old[i][1]);if(r&&r.id)map.set(r.id,{r,row:i+1})}catch(_){}for(const r of(p.records||[])){if(!r.id||!r.date||!Number.isFinite(Number(r.amount)))continue;const o=map.get(r.id);if(!o){sh.appendRow(['RECORD',JSON.stringify(r),r.updatedAt||Date.now()]);writeMonthly_(r)}else if((r.updatedAt||0)>(o.r.updatedAt||0))sh.getRange(o.row,2,1,2).setValues([[JSON.stringify(r),r.updatedAt||Date.now()]])}const c=p.config||{},data=sh.getDataRange().getValues();let row=-1;for(let i=1;i<data.length;i++)if(data[i][0]==='CONFIG'){row=i+1;break}if(row<0)sh.appendRow(['CONFIG',JSON.stringify(c),c.updatedAt||Date.now()]);else{let oc={};try{oc=JSON.parse(data[row-1][1])}catch(_){}if((c.updatedAt||0)>(oc.updatedAt||0))sh.getRange(row,2,1,2).setValues([[JSON.stringify(c),c.updatedAt||Date.now()]])}return {ok:true}}
function money_(v){if(typeof v==='number')return v;const n=Number(String(v==null?'':v).replace(/[¥￥,\s]/g,''));return Number.isFinite(n)?n:NaN}
function text_(v){return v==null?'':String(v).trim()}
function importMonthlySheets(){const ss=SpreadsheetApp.openById(SHEET_ID),sync=sheet_(),existing=sync.getDataRange().getValues(),ids=new Set();for(let i=1;i<existing.length;i++)if(existing[i][0]==='RECORD')try{const r=JSON.parse(existing[i][1]);if(r&&r.id)ids.add(r.id)}catch(_){}
let added=0,skipped=0;['8月','9月'].forEach(name=>{const sh=ss.getSheetByName(name);if(!sh)return;const vals=sh.getDataRange().getValues();if(vals.length<2)return;const hdr=vals[1].map(text_),ix=s=>hdr.indexOf(s);const day=ix('日'),purpose=ix('用途'),payment=ix('支払い方法'),who=ix('誰用?'),amount=ix('金額'),discount=ix('値引き（ポイント等）'),cls=ix('分類'),detail=ix('詳細'),month=Number(name.replace('月',''));if(day<0||amount<0)return;for(let i=2;i<vals.length;i++){const row=vals[i],d=Number(row[day]),a=money_(row[amount]);if(!Number.isFinite(d)||d<1||d>31||!Number.isFinite(a)||a===0){skipped++;continue}const date='2026-'+String(month).padStart(2,'0')+'-'+String(d).padStart(2,'0'),id='sheet-'+month+'-'+(i+1),rec={id,date,purpose:text_(row[purpose]),payment:text_(row[payment]),who:who>=0?text_(row[who]):'',amount:a,discount:discount>=0?(money_(row[discount])||0):0,classification:cls>=0?text_(row[cls]):'',detail:detail>=0?text_(row[detail]):'',updatedAt:1};if(ids.has(id))continue;sync.appendRow(['RECORD',JSON.stringify(rec),1]);ids.add(id);added++}});return {ok:true,added,skipped,total:ids.size}}

function jsonOut_(obj,cb){const s=JSON.stringify(obj);if(cb&&/^[A-Za-z_$][0-9A-Za-z_$\.]*$/.test(cb))return ContentService.createTextOutput(cb+'('+s+')').setMimeType(ContentService.MimeType.JAVASCRIPT);return ContentService.createTextOutput(s).setMimeType(ContentService.MimeType.JSON)}
function doPost(e){try{const p=JSON.parse((e&&e.postData&&e.postData.contents)||'{}');return jsonOut_(writeData(p))}catch(err){return jsonOut_({ok:false,error:String(err)})}}
function doGet(e){if(e&&e.parameter&&e.parameter.action==='read')return jsonOut_(readData(),e.parameter.callback);const html=`<!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,viewport-fit=cover"><style>*{box-sizing:border-box}html,body{margin:0!important;padding:0!important;width:100%!important;min-width:100%!important;height:100%!important;overflow:hidden!important;background:#f7f3ee}#app{position:fixed!important;top:0!important;left:0!important;width:100%!important;max-width:none!important;height:100%!important;border:0!important;margin:0!important;padding:0!important;display:block!important}@media(max-width:600px){#app{width:100vw!important;height:100dvh!important}}</style></head><body><iframe id="app" src="${APP_URL}&shared=1&mobile=1" allow="camera"></iframe><script>const f=document.getElementById('app');window.addEventListener('message',e=>{const d=e.data;if(!d||!d.type||!d.type.startsWith('kakeibo-bridge-'))return;const reply=(ok,payload,error)=>f.contentWindow.postMessage({type:'kakeibo-bridge-result',token:d.token,ok,payload,error},'*');if(d.type==='kakeibo-bridge-read')google.script.run.withSuccessHandler(x=>reply(true,x)).withFailureHandler(x=>reply(false,null,String(x))).readData();if(d.type==='kakeibo-bridge-write')google.script.run.withSuccessHandler(x=>reply(true,x)).withFailureHandler(x=>reply(false,null,String(x))).writeData(d.payload)})</script></body></html>`;return HtmlService.createHtmlOutput(html).setTitle('♡ 家計簿 ♡').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL)}
function setup(){const sh=sheet_();if(sh.getLastRow()===0)sh.appendRow(['TYPE','JSON','UPDATED_AT'])}